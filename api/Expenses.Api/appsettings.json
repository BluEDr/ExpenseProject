{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=expenses;User=appuser;Password=apppass;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32_CHARS_MIN",
    "Issuer": "Expenses.Api",
    "Audience": "Expenses.Api.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "AuditTime": {
    "TimeZoneId": "Europe/Athens"
  },
  "Storage": {
    "AttachmentsPath": "uploads"
  }
}
